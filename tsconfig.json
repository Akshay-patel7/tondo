{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // Node runs the scripts as they are, so their imports name .ts and .mts files.
    "allowImportingTsExtensions": true
  },
  // src/shared runs in the renderer and the host, so its tsconfig has no Node
  // types. Its tests and benches read fixtures with node:fs and are checked here.
  "include": [
    "*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "src/shared/**/*.test.ts",
    "src/shared/**/*.bench.ts"
  ]
}
